<resources>
    <!-- Tema escuro: faz o WebView reportar prefers-color-scheme: dark ao site
         quando o celular está no modo escuro (o tema "Automático" do app segue o sistema). -->
    <style name="Theme.Organizador" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
